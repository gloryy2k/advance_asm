# ─────────────────────────────────────────────────────────────
# BBASM config — copy sang `.env` rồi chỉnh. Mọi giá trị có default an toàn;
# thiếu API key → fail-soft (vẫn chạy, chỉ kém phong phú hơn).
# Xem §14 + §24 trong BUILD_SPEC.md.
# ─────────────────────────────────────────────────────────────

# --- Framework vendored (submodule) ---
BBASM_BBROOT=/opt/claude-bug-bounty
BBASM_TOOLS_SUBDIR=tools            # "tools" (bản pin cũ) | "bughunter/tools" (upstream mới, §23)

# --- Đường dẫn dữ liệu (volume mount) ---
BBASM_DATA=/app/data
BBASM_TARGETS=/app/targets

# --- Server ---
BBASM_BIND=127.0.0.1                # default localhost; đổi 0.0.0.0 CHỈ khi cố ý expose (§18)
BBASM_PORT=8000
BBASM_STATIC=/app/backend/static    # local dev: frontend/dist
BBASM_UPDATE_TEMPLATES=1            # container startup; 0 uses installed cache
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Recon defaults (chỉnh lại được ở bước REVIEW CONFIG mỗi scan) ---
BB_THREADS=50
BB_RATE_LIMIT=150                   # req/s
BBASM_DEFAULT_DEPTH=light           # passive | light | strong
BBASM_MAX_CONCURRENT_SCANS=2

# --- P2 safety switches (ENV-only; restart backend after changes) ---
BBASM_RECON_DISABLED=0              # 1 denies all recon launches
BBASM_NO_INTERACTSH=1               # 0 enables nuclei OAST callbacks
BBASM_NO_REDIRECT=1                 # 0 enables httpx/katana redirects
BBASM_SCOPE_CRAWL=1                 # 1 restricts katana to seed FQDN
BBASM_NO_VERIFY=1                   # 0 enables trufflehog live-key verification
BBASM_SKIP_HISTORICAL=0             # 1 disables all historical queries; IP/CIDR always skipped
BBASM_HISTORICAL_TIMEOUT=60         # domain historical budget (seconds, 1..300)

# --- Hard timeout mỗi depth (giây) ---
BBASM_SCAN_TIMEOUT_PASSIVE=300
BBASM_SCAN_TIMEOUT_LIGHT=900
BBASM_SCAN_TIMEOUT_STRONG=2700

# --- Cross-platform ---
# Thư mục config subfinder để mount (optional). Bỏ trống nếu không có (vd trên Windows).
SUBFINDER_CONFIG_DIR=

# --- API keys (tất cả OPTIONAL) ---
# ProjectDiscovery Chaos (subdomain)
CHAOS_KEY=
# secrets_hunter --github-org, source_code scope
GITHUB_TOKEN=
# HackerOne API (bbscope + policy_scopes giàu hơn)
H1_USER=
H1_TOKEN=
