# Chuẩn hoá line endings — chạy trong Linux container, tránh CRLF khi build trên Windows.
# Mọi file text checkout ra LF (quan trọng nhất cho *.sh / entrypoint — CRLF làm bash vỡ).
* text=auto eol=lf

*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Binary — không đụng vào
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.pdf   binary
