#!/bin/bash
# BBASM wrapper. nuclei downloads ~14,000 templates from the internet by itself when it finds none (and checks for
# updates on every start). A scan must never do that on its own: it is egress nobody approved, and it eats the
# stage budget. Without templates nuclei is skipped (the scan reports "thiếu nuclei-templates"); with templates it is
# started with the update check disabled.
. "$(dirname "$0")/_common.sh"
shim_dir="$(cd "$(dirname "$0")" && pwd)"
real="$(bbasm_real nuclei "$shim_dir")" || { echo "nuclei: not found" >&2; exit 127; }

official="${BBASM_NUCLEI_OFFICIAL:-}"
have_templates=0
if [ -n "$official" ] && [ -d "$official" ] && [ -n "$(find "$official" -name '*.yaml' -print -quit 2>/dev/null)" ]; then
    have_templates=1                      # the managed set (BBASM updates it on purpose)
else
    official=""
    for dir in "${HOME:-/nonexistent}/nuclei-templates" "${HOME:-/nonexistent}/.local/nuclei-templates"; do
        if [ -d "$dir" ] && [ -n "$(find "$dir" -name '*.yaml' -print -quit 2>/dev/null)" ]; then have_templates=1; fi
    done
fi
if [ "$have_templates" = 0 ]; then
    bbasm_note nuclei "không chạy: chưa có bộ template (nuclei sẽ tự tải từ internet nên BBASM chặn; cài ở trang Công cụ & môi trường)"
    exit 0
fi

has_duc=0; has_etags=0; has_as=0
for arg in "$@"; do case "$arg" in -duc|--duc|-disable-update-check) has_duc=1 ;; -etags|-exclude-tags|--exclude-tags) has_etags=1 ;; -as|--as|-automatic-scan) has_as=1 ;; esac; done
extra=()
[ "$has_duc" = 1 ] || extra+=(-duc)
# Templates that can take a service down, fuzz it or guess credentials need the user's explicit opt-in (Review).
if [ "${BBASM_NUCLEI_ALLOW_INTRUSIVE:-0}" != "1" ] && [ "$has_etags" = 0 ]; then
    extra+=(-etags dos,fuzz,intrusive,bruteforce,brute-force)
    bbasm_note nuclei "bỏ qua template gắn thẻ dos/fuzz/intrusive/brute-force (bật lại ở Review nếu policy cho phép)"
fi
# Point nuclei at the managed official set, plus the user's own templates chosen for this scan (added, not replacing).
if [ -n "$official" ]; then
    extra+=(-t "$official")
    while IFS= read -r custom; do [ -n "$custom" ] && [ -f "$custom" ] && extra+=(-t "$custom"); done <<<"${BBASM_NUCLEI_CUSTOM:-}"
fi
# -as: fingerprint each host and add templates matching its detected technology, on top of the filters above.
# Which template fires is decided by nuclei at scan time from that host's own answer -- nothing here can know it in
# advance. -vv (every template nuclei loaded, matched or not) is captured to nuclei/templates_loaded.txt so Run can
# show what actually happened, same folder recon_engine.sh's own Phase 9 already created for this command.
if [ "${BBASM_NUCLEI_AUTO_SELECT:-0}" = "1" ] && [ "$has_as" = 0 ]; then
    extra+=(-as -vv)
    bbasm_note nuclei "bật tự chọn template theo công nghệ (-as): nuclei tự dò công nghệ trên từng host rồi chọn thêm template khớp, ngoài severity/tag đã lọc"
    # V166_HOST_AUDIT.md P1: -as always reads its detection set from $HOME/nuclei-templates -- hardcoded, ignoring
    # -t, and it does not follow a symlink placed there either (confirmed against real nuclei v3.4.10/v3.11.1: a
    # symlink to the managed set reads as "no templates found"). Without a real directory there it fails outright
    # ("could not find any templates with tech tag") instead of just skipping auto-select. Keep a HARD-linked (not
    # symlinked) copy of the managed set at that exact path, refreshed before every run so it is never stale and
    # never triggers nuclei's own download. Hard links cost no extra disk on the same filesystem (~0.3s for the
    # full ~14k-template set); if the managed set and $HOME ever end up on different filesystems, fall back to a
    # real copy rather than leaving a half-populated directory.
    if [ -n "$official" ]; then
        home_templates="${HOME:-/root}/nuclei-templates"
        if [ "$(cd "$official" 2>/dev/null && pwd -P)" != "$(cd "$home_templates" 2>/dev/null && pwd -P)" ]; then
            rm -rf "$home_templates"
            cp -rl "$official" "$home_templates" 2>/dev/null || { rm -rf "$home_templates"; cp -r "$official" "$home_templates"; }
        fi
    fi
    if [ -n "${RECON_OUT_DIR:-}" ] && [ -d "$RECON_OUT_DIR/nuclei" ]; then
        # V166_HOST_AUDIT.md P3: nuclei echoes each finding's full JSONL record to stdout too (even with -o and
        # -silent), interleaved with -vv's own "[id] Name (@author) [severity]" lines on the SAME stream. A finding
        # record is distinguishable on sight (a JSON object); drop those here so this file is only the template
        # list it claims to be -- findings.jsonl (via -o) stays the one place findings are read from.
        "$real" "${extra[@]}" "$@" | grep -v '^{' > "$RECON_OUT_DIR/nuclei/templates_loaded.txt"
        exit "${PIPESTATUS[0]}"
    fi
fi
exec "$real" "${extra[@]}" "$@"
