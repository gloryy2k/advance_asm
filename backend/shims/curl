#!/bin/bash
# BBASM wrapper, first on PATH for recon commands. The pinned recon scripts call curl without any time limit
# (Wayback once held a whole scan for 11 minutes). Every call now gets an upper bound unless the caller set one.
# Calls to the known passive sources are also recorded (host + outcome only, never the URL or the response).
. "$(dirname "$0")/_common.sh"
shim_dir="$(cd "$(dirname "$0")" && pwd)"
real="$(bbasm_real curl "$shim_dir")" || { echo "curl: not found" >&2; exit 127; }

has_max=0; url=""
for arg in "$@"; do
    case "$arg" in
        --max-time|--max-time=*|-m|-m[0-9]*) has_max=1 ;;
        http://*|https://*) [ -z "$url" ] && url="$arg" ;;
    esac
done
args=("$@")
[ "$has_max" = 0 ] && args=(--max-time "${BBASM_SOURCE_TIMEOUT:-45}" --connect-timeout 15 "$@")

host="${url#*://}"; host="${host%%/*}"; host="${host%%\?*}"; host="${host%%:*}"
is_source=0
for known in ${BBASM_SOURCE_HOSTS:-crt.sh web.archive.org}; do [ "$host" = "$known" ] && is_source=1; done

# Policy header (BBHUNT_AUTH_HEADERS, one "Name: value" per line): every curl that reaches the target carries it, even
# in scripts that do not know about it (JS download for secret scanning). Passive sources never get it, and a header
# the caller already set is left alone.
if [ "$is_source" = 0 ] && [ -n "$url" ] && [ -n "${BBHUNT_AUTH_HEADERS:-}" ]; then
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        name="${line%%:*}"; have=0; prev=""
        for arg in "$@"; do
            [ "$prev" = "-H" ] || [ "$prev" = "--header" ] && case "$(printf '%s' "$arg" | tr 'A-Z' 'a-z')" in "$(printf '%s' "$name" | tr 'A-Z' 'a-z')":*) have=1 ;; esac
            prev="$arg"
        done
        [ "$have" = 0 ] && args=(-H "$line" "${args[@]}")
    done <<< "$BBHUNT_AUTH_HEADERS"
fi

start=$SECONDS
"$real" "${args[@]}"
code=$?

for known in ${BBASM_SOURCE_HOSTS:-crt.sh web.archive.org}; do
    if [ "$host" = "$known" ]; then
        status=ok; [ "$code" = 28 ] && status=timeout; { [ "$code" != 0 ] && [ "$code" != 28 ]; } && status=error
        bbasm_record "$host" "$status" "$((SECONDS - start))" "$code"
    fi
done
exit "$code"
